NEXT_PUBLIC_SITE_URL=https://theruff.agency
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@theruff.agency
CONTACT_FROM_EMAIL=website@theruff.agency
# Talent-pool applications. Optional — defaults to CONTACT_TO_EMAIL.
CAREERS_TO_EMAIL=careers@theruff.agency

# Cloudinary. Only the cloud name is needed to serve images; the key and secret
# are for signed uploads.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
# The preset sets no folder of its own, so uploads must name one.
CLOUDINARY_FOLDER=ruff-agency

# ---------------------------------------------------------------------------
# The admin panel at /admin. All optional: with none of these set the public
# site renders the content and design committed to the repository, and /admin
# shows its setup notice instead of erroring.
#
# The first three come from `vercel env pull` once the Supabase integration is
# installed. The anon key is safe in the browser — every table is
# row-level-secured and default-deny.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Salt for the daily visitor digest. Any long random string; analytics stores a
# hash of an address, never the address, and this is what stops that hash being
# a table anyone could rebuild. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SALT=
